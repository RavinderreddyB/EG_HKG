# (data/processed/ is now committed on purpose -- see project README)
data/raw/medlineplus/
data/raw/medquad/

# license-restricted, no-redistribution third-party data (DrugBank CC BY-NC,
# MedDRA proprietary terms embedded in SIDER export) -- keep local only
data/raw/drugs/db_drug_interactions.csv
data/raw/drugs/meddra_all_indications.tsv